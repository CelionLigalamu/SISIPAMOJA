SECRET_KEY=replace-with-a-new-secret-key
DEBUG=False
ALLOWED_HOSTS=yourdomain.co.ke,www.yourdomain.co.ke,sisipamoja.onrender.com
DATABASE_URL=postgres://user:password@host:5432/database_name

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=SISIPAMOJA <your-email@gmail.com>

MPESA_ENVIRONMENT=sandbox
MPESA_SHORTCODE=174379
MPESA_CONSUMER_KEY=replace-with-mpesa-consumer-key
MPESA_CONSUMER_SECRET=replace-with-mpesa-consumer-secret
MPESA_PASSKEY=replace-with-mpesa-passkey
MPESA_CALLBACK_URL=https://yourdomain.co.ke/mpesa/callback/

AT_USERNAME=replace-with-africas-talking-username
AT_API_KEY=replace-with-africas-talking-api-key
AT_SENDER_ID=
